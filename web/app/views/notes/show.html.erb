<% content_for :title, "投稿" %>
<div class="detail" data-controller="live" data-live-thread-value="<%= @note["id"] %>">
  <% if @note %>
    <article class="tl-item tl-item--detail" data-note-id="<%= @note["id"] %>" data-pubkey="<%= @note["pubkey"] %>">
      <a class="tl-item__avatar" href="<%= profile_path(@note["pubkey"]) %>" aria-label="プロフィール">
        <%= avatar_tag(@note["pubkey"], klass: "avatar--lg") %>
      </a>
      <div class="tl-item__main">
        <span class="tl-item__head">
          <span class="tl-item__name" data-profile-name><%= display_name(@note["pubkey"]) %></span>
          <span class="tl-item__time"><%= rel_time(@note["created_at"]) %></span>
        </span>
        <span class="tl-item__body tl-item__body--detail"><%= note_content(@note["content"]) %></span>
      </div>
    </article>

    <%= render "notes/thread_section" %>
  <% else %>
    <div class="empty-state">
      <span class="msr empty-state__icon">search_off</span>
      <p class="empty-state__title">投稿が見つかりません</p>
      <p class="empty-state__body">削除されたか、まだ取り込まれていない可能性があります。</p>
    </div>
  <% end %>
</div>
