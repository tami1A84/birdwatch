<% content_for :title, "投稿" %>
<div class="detail" data-controller="live" data-live-thread-value="<%= @note["id"] %>">
  <% if @note %>
    <article class="note-card note-card--detail" data-note-id="<%= @note["id"] %>" data-pubkey="<%= @note["pubkey"] %>">
      <div class="note-card__head">
        <md-icon-button class="note-card__avatar" href="<%= profile_path(@note["pubkey"]) %>" aria-label="プロフィール">
          <span class="msr msr--outline">account_circle</span>
        </md-icon-button>
        <span class="note-card__author" data-profile-name><%= display_name(@note["pubkey"]) %></span>
        <span class="note-card__time"><%= rel_time(@note["created_at"]) %></span>
      </div>
      <div class="note-card__text note-card__text--static"><%= note_content(@note["content"]) %></div>
    </article>

    <%= render "notes/thread_section" %>
  <% else %>
    <div class="empty-state">
      <span class="msr empty-state__icon">search_off</span>
      <p class="empty-state__title">投稿が見つかりません</p>
      <p class="empty-state__body">削除されたか、まだ取り込まれていない可能性があります。</p>
    </div>
  <% end %>
</div>
