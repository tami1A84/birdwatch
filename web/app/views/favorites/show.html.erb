<% content_for :title, "お気に入り" %>
<div class="page" data-controller="favorites">
  <h1 class="page-title">お気に入り</h1>
  <div class="feed" data-favorites-target="list">
    <div class="empty-state" data-favorites-target="empty">
      <span class="msr empty-state__icon">star</span>
      <p class="empty-state__title">お気に入りはまだありません</p>
      <p class="empty-state__body">投稿詳細の star ボタンで保存できます。お気に入りはこのブラウザに保存されます。</p>
    </div>
  </div>
</div>
