<% content_for :title, "設定" %>
<div class="page">
  <h1 class="page-title">設定</h1>

  <section class="settings-card">
    <h2 class="settings-card__title">アカウント</h2>
    <% if @me %>
      <div class="settings-row">
        <span class="settings-row__label">公開鍵</span>
        <code class="settings-row__value settings-row__value--mono"><%= @me %></code>
      </div>
      <% if @my_profile["display_name"].present? || @my_profile["name"].present? %>
        <div class="settings-row">
          <span class="settings-row__label">名前</span>
          <span class="settings-row__value"><%= @my_profile["display_name"].presence || @my_profile["name"] %></span>
        </div>
      <% end %>
    <% else %>
      <p class="settings-card__body">nostrd に接続できていません。</p>
    <% end %>
    <div class="settings-row">
      <span class="settings-row__label">署名</span>
      <span class="settings-row__value"><%= @locked ? "ロック中" : "準備完了" %></span>
    </div>
  </section>

  <section class="settings-card">
    <h2 class="settings-card__title">リモート署名 (NIP-46 bunker)</h2>
    <% if @bunker_enabled %>
      <% if @bunker_connected %>
        <div class="settings-row">
          <span class="settings-row__label">状態</span>
          <span class="settings-row__value">接続中 (<code class="settings-row__value--mono"><%= short_pubkey(@bunker_client) %></code>)</span>
        </div>
        <p class="settings-card__body settings-card__body--muted">
          投稿・いいね・削除などの書き込みは、家のデーモンがbunker経由で署名します。鍵はブラウザにもサーバーにも保存されません。
        </p>
        <%= button_to settings_bunker_disconnect_path, method: :post, class: "danger-button",
              form: { data: { confirm: "bunkerから切断しますか？接続するまで書き込みができなくなります。", confirm_title: "切断" } } do %>
          <span class="msr" slot="icon">link_off</span>
          切断
        <% end %>
      <% else %>
        <p class="settings-card__body">未接続です。このままでは閲覧のみ可能で、書き込み操作はできません。</p>
        <%= form_with url: settings_bunker_connect_path, method: :post, class: "settings-form" do %>
          <label class="field">
            <span class="field__label">bunker URI</span>
            <%= text_field_tag :bunker_uri, nil, class: "field__input", placeholder: "bunker://…", required: true, autocomplete: "off", spellcheck: "false" %>
          </label>
          <md-filled-button type="submit">
            <span class="msr" slot="icon">key</span>
            接続
          </md-filled-button>
        <% end %>
        <p class="settings-card__body settings-card__body--muted">
          URIは家のPCで <code>bin/nostr --bunker-secret</code> を実行すると発行されます。
        </p>
      <% end %>
    <% else %>
      <p class="settings-card__body settings-card__body--muted">
        bunkerは無効です（デーモンに bunker.json がありません）。ローカル専用モードで動作中。
      </p>
    <% end %>
  </section>

  <section class="settings-card">
    <h2 class="settings-card__title">プロフィール</h2>
    <%= form_with url: settings_profile_path, method: :post, class: "settings-form" do %>
      <label class="field">
        <span class="field__label">ユーザー名</span>
        <%= text_field_tag :name, @my_profile["name"], class: "field__input", maxlength: 64 %>
      </label>
      <label class="field">
        <span class="field__label">表示名</span>
        <%= text_field_tag :display_name, @my_profile["display_name"], class: "field__input", maxlength: 64 %>
      </label>
      <label class="field">
        <span class="field__label">NIP-05</span>
        <%= text_field_tag :nip05, @my_profile["nip05"], class: "field__input", placeholder: "you@example.com" %>
      </label>
      <label class="field">
        <span class="field__label">アイコンURL</span>
        <%= url_field_tag :picture, @my_profile["picture"], class: "field__input", placeholder: "https://…" %>
      </label>
      <label class="field">
        <span class="field__label">自己紹介</span>
        <%= text_area_tag :about, @my_profile["about"], rows: 3, class: "field__input field__input--area", maxlength: 1024 %>
      </label>
      <md-filled-button type="submit">保存</md-filled-button>
    <% end %>
  </section>

  <section class="settings-card">
    <h2 class="settings-card__title">ロック</h2>
    <% if @locked %>
      <%= form_with url: settings_unlock_path, method: :post, class: "settings-form" do %>
        <label class="field">
          <span class="field__label">パスフレーズ</span>
          <%= password_field_tag :passphrase, nil, class: "field__input", required: true, autocomplete: "current-password" %>
        </label>
        <md-filled-button type="submit">
          <span class="msr" slot="icon">lock_open</span>
          ロック解除
        </md-filled-button>
      <% end %>
    <% else %>
      <p class="settings-card__body">ロックすると、パスフレーズを再入力するまでデーモンは署名しなくなります。</p>
      <%= button_to settings_lock_path, method: :post, class: "danger-button",
            form: { data: { confirm: "デーモンをロックしますか？", confirm_title: "ロック" } } do %>
        <span class="msr" slot="icon">lock</span>
        ロック
      <% end %>
    <% end %>
  </section>

  <section class="settings-card">
    <h2 class="settings-card__title">デーモン</h2>
    <div class="settings-row">
      <span class="settings-row__label">フォロー</span>
      <span class="settings-row__value"><%= @follow_count %> 人</span>
    </div>
    <div class="settings-row">
      <span class="settings-row__label">リレー</span>
      <span class="settings-row__value"><%= @relay_count %> 件</span>
    </div>
    <p class="settings-card__body settings-card__body--muted">nostrd のソケット: <code><%= nostrd.socket_path %></code></p>
  </section>
</div>
