#!/usr/bin/env ruby
# frozen_string_literal: true

# nostr-nsite — publish a static directory as a NIP-5A named site (nsite).
#
#   nostr-nsite --socket /run/user/1000/nostrd.sock <dir> [options]
#
# Flow (NIP-5A + Blossom BUD-01/02):
#   1. hash every file under <dir>; paths become manifest "path" tags
#   2. upload each blob (PUT /upload, Blossom auth kind 24242 signed by the
#      daemon via the sign_raw socket op)
#   3. build the kind 35128 manifest (d=<name>, x aggregate hash, server
#      hints), sign + publish it through the daemon (publish_raw op)
#   4. rebroadcast the signed manifest to the relays nsite gateways watch
#      (the daemon's pool may not overlap them; no re-signing involved)
#   5. print the canonical gateway URLs
#
# The daemon must be running and unlocked; it holds the key, this script
# never sees it. Run `bin/nostr` (daemon) again after upgrading nostrd so
# the sign_raw/publish_raw ops exist.

require "net/http"
require "json"
require "digest"
require "base64"
require "uri"
require "socket"
require "optparse"
require_relative "../lib/nostrd/blossom"

# extension -> content-type (keep minimal; unknown files upload as
# application/octet-stream, which some servers reject)
MIME = {
  ".html" => "text/html", ".htm" => "text/html", ".js" => "text/javascript",
  ".mjs" => "text/javascript", ".css" => "text/css", ".json" => "application/json",
  ".webmanifest" => "application/manifest+json", ".png" => "image/png",
  ".jpg" => "image/jpeg", ".jpeg" => "image/jpeg", ".gif" => "image/gif",
  ".svg" => "image/svg+xml", ".webp" => "image/webp", ".ico" => "image/x-icon",
  ".txt" => "text/plain", ".woff" => "font/woff", ".woff2" => "font/woff2",
  ".map" => "application/json", ".xml" => "application/xml"
}.freeze

DEFAULT_SERVERS = %w[
  https://files.sovbit.host
  https://nostr.download
  https://cdn.nostrcheck.me
  https://blossom.primal.net
].freeze

# The embedded blossom takes a mirror copy of every uploaded blob: the
# private restore source when public servers disappear. Its loopback URL
# never reaches manifest server tags (Client.loopback? filters them).
LOCAL_BLOSSOM = "http://127.0.0.1:7778"

# NIP-5A host gateways that exist today. They resolve nsites by watching
# relays for manifest events; a fresh publish can take a bit to appear.
GATEWAYS = %w[nsite.lol].freeze

# Relays nsite gateways are known to watch (nsite.lol's set, 2026-09-06).
# The daemon publishes to its own pool, which need not overlap this list —
# the manifest is already signed, so rebroadcasting it verbatim afterwards
# costs nothing and needs no key.
GATEWAY_RELAYS = %w[
  wss://relay.damus.io
  wss://nos.lol
  wss://relay.nostr.band
  wss://nostr.wine
  wss://relay.primal.net
  wss://relay.nostr.bg
  wss://relay.snort.social
  wss://purplepag.es
].freeze

def die(msg)
  warn "nostr-nsite: #{msg}"
  exit 1
end

# One request/response over the daemon's NDJSON socket. The ops answer with
# exactly one line; anything else is a protocol error worth aborting on.
def socket_op(path, op, params = {})
  UNIXSocket.open(path) do |s|
    s.write(JSON.generate(op: op, id: "nsite_#{Process.pid}", params: params) + "\n")
    resp = JSON.parse(s.gets.to_s)
    die "daemon said: #{resp['error'] || 'no reply'}" unless
      resp["ev"] == "result" && resp.fetch("ok", true)

    resp["data"]
  end
rescue Errno::ENOENT, Errno::ECONNREFUSED
  die "nostrd not reachable at #{path} — start it first: nostr"
rescue JSON::ParserError
  die "daemon returned garbage on #{path}"
end

def sign_auth(socket_path, url, method:, x: nil)
  tags = [["t", "upload"], ["u", url], ["method", method], ["expiration", (Time.now.to_i + 3600).to_s]]
  tags.insert(1, ["x", x]) if x
  socket_op(socket_path, "sign_raw", kind: 24242, content: "", tags: tags)["event"]
end

def upload(socket_path, server, sha, data, mime)
  auth = sign_auth(socket_path, "#{server}/upload", method: "PUT", x: sha)
  Nostrd::Blossom::Client.put(server, "/upload", body: data, mime: mime,
                              auth: "Nostr #{Base64.strict_encode64(JSON.generate(auth))}")
end

# Rebroadcast an already-signed event to one relay, verbatim. Returns
# [ok, info]. Short-lived blocking connection — no threads to clean up.
def broadcast(url, event, timeout: 8)
  uri = URI.parse(url)
  tls = uri.scheme == "wss"
  port = uri.port || (tls ? 443 : 80)
  tcp = TCPSocket.new(uri.host, port)
  sock = tcp
  if tls
    ssl = OpenSSL::SSL::SSLSocket.new(tcp)
    ssl.sync_close = true
    ssl.hostname = uri.host
    ssl.connect
    sock = ssl
  end
  key = SecureRandom.base64(16)
  path = uri.path.empty? ? "/" : uri.path
  sock.write(
    "GET #{path} HTTP/1.1\r\nHost: #{uri.host}:#{port}\r\n" \
    "Upgrade: websocket\r\nConnection: Upgrade\r\n" \
    "Sec-WebSocket-Key: #{key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
  )
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
  head = +""
  while !head.include?("\r\n\r\n") && Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
    head << sock.read_nonblock(4096, exception: false)
  end
  raise "handshake: #{head[/\AHTTP\/[\d.]+\s*(\S+)/, 1]}" unless head.include?(" 101")

  sock.write(WebSocket::Frame::Outgoing::Client.new(
    data: JSON.generate(["EVENT", event]), type: :text, version: 13
  ).to_s)
  frames = WebSocket::Frame::Incoming::Client.new
  result = nil
  while result.nil? && Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
    data = sock.read_nonblock(4096, exception: false)
    if data == :wait_readable
      sleep 0.05
    elsif data.nil?
      break
    else
      frames << data
      while (frame = frames.next)
        msg = JSON.parse(frame.to_s) rescue next
        result = msg[2] == true if msg.is_a?(Array) && msg[0] == "OK" && msg[1] == event["id"]
      end
    end
  end
  [result == true, result.nil? ? "timeout" : "accepted"]
rescue StandardError => e
  [false, e.class.to_s]
ensure
  begin; sock&.close; rescue StandardError; end
  begin; tcp&.close; rescue StandardError; end
end

opts = { name: "birdwatch", servers: [] }
OptionParser.new do |o|
  o.banner = "usage: nostr-nsite --socket PATH <dir> [options]"
  o.on("--socket PATH") { |v| opts[:socket] = v }
  o.on("--name NAME", "named-site d tag (1-13 chars, lowercase)") { |v| opts[:name] = v.downcase }
  o.on("--title TITLE") { |v| opts[:title] = v }
  o.on("--desc DESC") { |v| opts[:desc] = v }
  o.on("--server URL", "extra blossom server (repeatable)") { |v| opts[:servers] << v }
  o.on("--no-local-mirror", "skip mirroring blobs to the embedded blossom (127.0.0.1:7778)") do
    opts[:no_local_mirror] = true
  end
  o.on("--gateway-relay URL", "extra relay to rebroadcast the manifest to (repeatable/comma-sep)") do |v|
    (opts[:gateway_relays] ||= []).concat(v.split(","))
  end
  o.on("--no-gateway-relays", "skip rebroadcasting the manifest to gateway relays") { opts[:skip_gateway_relays] = true }
end.parse!
die "a directory to publish is required" unless ARGV[0]
die "no such directory: #{ARGV[0]}" unless File.directory?(ARGV[0])
die "--socket is required" unless opts[:socket]
die "bad --name #{opts[:name].inspect}" unless opts[:name].match?(/\A[a-z0-9-]{1,13}\z/) && !opts[:name].end_with?("-")

root = File.realpath(ARGV[0])
files = Dir.glob("#{root}/**/*", File::FNM_DOTMATCH).select { |f| File.file?(f) }
die "no files under #{root}" if files.empty?

# 1. hash (paths are absolute-from-root, matching NIP-5A "/absolute/path")
paths = files.map { |f| [f.delete_prefix("#{root}/").prepend("/"), f] }
             .sort_by { |rel, _| rel }
blobs = paths.map do |rel, abs|
  data = File.binread(abs)
  [rel, Digest::SHA256.hexdigest(data), data, MIME[File.extname(rel).downcase]]
end

# 2. upload (best effort per server; one success per blob is enough — GETs
# are anonymous and content-addressed). The embedded blossom takes a mirror
# copy FIRST: even an aborted run leaves restorable copies locally, and its
# loopback URL is filtered out of the manifest's server tags.
servers = (DEFAULT_SERVERS + opts[:servers]).uniq
ok_servers = []
blobs.each do |rel, sha, data, mime|
  mime ||= "application/octet-stream"
  unless opts[:no_local_mirror]
    ok, info = upload(opts[:socket], LOCAL_BLOSSOM, sha, data, mime)
    warn "  #{rel} -> local mirror failed (#{info})" unless ok
  end
  uploaded = []
  servers.each do |server|
    ok, info = upload(opts[:socket], server, sha, data, mime)
    uploaded << server if ok
    puts "  #{rel} -> #{File.basename(URI(server).host)}: #{info}" if ok || uploaded.empty?
    break if ok && uploaded.size >= 2 # two healthy copies per blob
  end
  ok_servers |= uploaded.reject { |s| Nostrd::Blossom::Client.loopback?(s) }
  die "no server accepted #{rel} (#{sha}) — a local mirror copy was kept" if uploaded.empty?
end

# 3. manifest: kind 35128 with path/x/server tags (NIP-5A)
path_tags = blobs.map { |rel, sha, _| ["path", rel, sha] }
aggregate = Digest::SHA256.hexdigest(
  blobs.map { |rel, sha, _| "#{sha} #{rel}\n" }.sort.join
)
tags = path_tags + [["x", aggregate, "aggregate"], ["d", opts[:name]]] +
       ok_servers.map { |s| ["server", s] } +
       [["title", opts[:title] || opts[:name]]] +
       (opts[:desc] ? [["description", opts[:desc]]] : [])
event = socket_op(opts[:socket], "publish_raw",
                  kind: 35128, content: "", tags: tags)["event"]

# 4. rebroadcast the signed manifest verbatim to the relays nsite gateways
#    watch. The daemon publishes to its own pool, which may not overlap
#    that set — a signed event needs no key to relay (2026-09-06: the
#    gateway kept serving the previous version until this step existed).
unless opts[:skip_gateway_relays]
  targets = (GATEWAY_RELAYS + (opts[:gateway_relays] || [])).uniq
  puts "rebroadcasting manifest to #{targets.size} gateway relays:"
  targets.each do |u|
    ok, info = broadcast(u, event)
    puts "  #{URI.parse(u).host}: #{ok ? 'accepted' : "not accepted (#{info})"}"
  end
end

# 5. canonical URLs (NIP-5A address format: <pubkeyB36><d>.host)
b36 = event["pubkey"].to_i(16).to_s(36)
puts JSON.pretty_generate(event)
puts
puts "published kind 35128 d=#{opts[:name]} (x=#{aggregate[0, 16]}…)"
puts "manifest id: #{event['id']}"
GATEWAYS.each do |gw|
  puts "  https://#{b36}#{opts[:name]}.#{gw}/"
end
